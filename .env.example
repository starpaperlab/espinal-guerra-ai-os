# Obligatorias para autenticación, CRM y gestión privada de infraestructura nativa.
# Usar el proyecto Supabase existente. No incluir valores reales en Git.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Opcionales: solo para captación desde un backend externo firmado o n8n.
# No se requieren para el CRM autenticado ni para el outbox transaccional.
SUPABASE_SERVICE_ROLE_KEY=
CRM_WEBHOOK_SECRET=

# Compatibilidad con envíos UUID antiguos de n8n, sin capture_source_key.
# El modo nuevo resuelve la organización en crm_enterprise_settings.
CRM_WEBHOOK_ORGANIZATION_ID=

# CRM_BRAND_ID no es una variable de Vercel utilizada por la aplicación.
# El helper antiguo de n8n aún puede usarla; no eliminarla allí si sigue activo.
